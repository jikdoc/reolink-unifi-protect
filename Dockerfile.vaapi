# VAAPI-enabled unifi-cam-proxy for the Steegers house.
#
# Hardware: UGREEN NAS, Intel Core i5-1235U (Iris Xe iGPU), Unraid 7.2.3,
# /dev/dri/renderD128 exposed. Upstream's published image is Alpine 3.10 with
# an ffmpeg that has VAAPI encoders compiled in but NO Intel driver, so VAAPI
# cannot initialize there. This image builds on Debian 13 (glibc): its
# ffmpeg 7.1 can mux HEVC into FLV ("enhanced FLV"), which the current
# H.265-passthrough plan needs, and the Intel iHD driver + oneVPL runtime
# keep the QSV fallback (--hw-transcode in unifi/cams/base.py) working if
# Protect refuses the passthrough stream.
#
# Build (on the NAS, where the iGPU is):
#   docker build -f Dockerfile.vaapi -t unifi-cam-proxy:vaapi .
# Node stage: supplies the `node` binary and the AI box sidecar's installed dependencies for
# `--ai-sidecar` (the proxy runs it as a subprocess; see deploy/ai-sidecar and docs/PROTECT-7.3.md).
# Homelab: base images pinned by digest, the sidecar by its lock file and the Python
# packages by requirements.lock, so a rebuild cannot pull in different code. Apt
# packages come from the Debian 13 archive at build time, and `apt-get upgrade`
# also brings the pinned base's own packages current, so rebuilding picks up every
# Debian security fix: cd /opt/rup/deploy/protect-bridge && docker compose build
# && docker compose up -d
#
# Debian 13 instead of Ubuntu 24.04: Ubuntu's iHD 24.1 / libva 1.20 fails to
# initialise ("iHD_drv_video.so init failed") on pvemed's i7-12700 under Proxmox
# kernel 7.0, so the --lo-h265-transcode QSV encode could not start. Debian 13's
# iHD 25.2 works. Its ffmpeg 7.1 produces the same enhanced-FLV HEVC tags as 6.1
# through unifi.hevc_flv (checked 2026-10-19: identical tag stream and bytes).
FROM node:22.23.4-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS sidecar
WORKDIR /opt/ai-sidecar
COPY deploy/ai-sidecar/package.json deploy/ai-sidecar/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY deploy/ai-sidecar/index.mjs deploy/ai-sidecar/decode.mjs ./

FROM debian:trixie@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5

ENV DEBIAN_FRONTEND=noninteractive \
    LIBVA_DRIVER_NAME=iHD \
    PIP_NO_CACHE_DIR=1

# intel-media-va-driver-non-free lives in Debian's non-free component.
RUN sed -i 's/^Components: main$/Components: main contrib non-free non-free-firmware/' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        build-essential git pkg-config ca-certificates \
        libjpeg-dev zlib1g-dev \
        ffmpeg netcat-openbsd \
        intel-media-va-driver-non-free libva2 libva-drm2 vainfo \
        libvpl2 libmfx-gen1.2 \
    && rm -rf /var/lib/apt/lists/*

# Isolated venv avoids Debian's PEP 668 "externally-managed" pip restriction.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY requirements.txt requirements.lock ./
RUN pip install -c requirements.lock -U pip wheel setuptools maturin \
    && pip install -c requirements.lock -r requirements.txt

COPY . .
RUN pip install -c requirements.lock .

COPY --from=sidecar /usr/local/bin/node /usr/local/bin/node
COPY --from=sidecar /opt/ai-sidecar /opt/ai-sidecar

COPY ./docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["unifi-cam-proxy"]
