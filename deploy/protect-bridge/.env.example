# Copy to .env next to docker-compose.yml (gitignored; chmod 600) and fill in.

# UNVR running Protect
NVR_IP=192.168.30.6

# From https://192.168.30.6/proxy/protect/api/cameras/manage-payload while logged
# in; expires after ~60 minutes and is single-use, so fetch it right before adopting.
ADOPTION_TOKEN=

# MAC of the virtual camera Protect adopts. Locally administered (02:...), NOT the
# Reolink's own MAC; changing it makes Protect see a brand-new camera.
CAM_MAC=02:52:4C:36:67:66

CAM_IP=192.168.30.36
CAM_NAME="Elite Sophia"
CAM_USER=admin
# Raw password, in single quotes so compose does not expand $ inside it.
CAM_PASS=''
# Same password percent-encoded (python3 -c "import urllib.parse,sys;
# print(urllib.parse.quote(sys.argv[1], safe=''))" 'password').
CAM_PASS_URL=

# Second camera: OMVI 3i PoE "Back Gate" (same user/password as above)
BG_ADOPTION_TOKEN=
BG_MAC=02:52:4C:95:4B:65
BG_IP=192.168.30.34
BG_NAME="Back Gate"
